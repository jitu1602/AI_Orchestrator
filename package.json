{
  "name": "qa-orchestrator-playwright",
  "version": "1.0.0",
  "description": "Playwright TypeScript target project for the QA Orchestrator agent pipeline",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:report": "playwright test --reporter=list,json",
    "ui:data": "node ui/build-data.js",
    "ui:refresh": "playwright test && node ui/build-data.js",
    "ui:serve": "node ui/serve.js",
    "test:headed": "playwright test --headed",
    "typecheck": "tsc --noEmit",
    "install:browsers": "playwright install"
  },
  "keywords": ["qa", "playwright", "automation", "page-object-model"],
  "author": "QA Orchestrator",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0"
  }
}
